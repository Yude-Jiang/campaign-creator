# Campaign Factory — Environment Configuration
# Copy this file to .env and fill in at least one provider's API key.
#
# Task routing (app/services/llm_router.py) prefers Gemini for grounded
# research, DeepSeek for structured Chinese generation, and Kimi for
# long-context analysis. Each task falls back through the other two, so the
# app runs with a single key configured — just with degraded routing.

# ── Gemini (Google) ──
# Either Vertex AI (project + gcloud ADC) or an AI Studio API key.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=
# Get an AI Studio key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── DeepSeek ──
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Kimi (Moonshot) ──
# Get from: https://platform.moonshot.cn/
# NOTE: the OpenAI-compatible client appends /chat/completions, so the base
# URL must keep its /v1 suffix.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# ── App Settings ──
APP_ENV=development
DEFAULT_LANGUAGE=zh
DATA_DIR=data
